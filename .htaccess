RewriteEngine On

# RewriteBase indispensable sur webetu :
# à adapter à votre
RewriteBase /www/e32772u/BUT_Info_S3/SAE/Touiteur

# Le Dispatcher utilise des chemins relatifs. Depuis /admin/, redirige
# les ressources statiques vers les dossiers partagés à la racine.
RewriteRule ^admin/(css|js|image)/(.*)$ $1/$2 [L]

# Le Dispatcher utilise des chemins relatifs. Depuis /admin/, redirige
# les ressources statiques vers les dossiers partagés à la racine.
RewriteRule ^admin/(css|js|image)/(.*)$ $1/$2 [L]

#
# Pour interdire l'accès aux répertoires contenant du code
RewriteRule ^sql(/.*|)$ - [NC,F]   # interdit l'accès à touiteur/sql
RewriteRule ^src(/.*|)$ - [NC,F]   # interdit l'accès à touiteur/src (il ne doit pas contenir index.php)
RewriteRule \.ini$ - [NC,F]   # interdit l'accès à tous les fichiers .ini
